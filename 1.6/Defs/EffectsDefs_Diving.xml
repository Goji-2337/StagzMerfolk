<?xml version="1.0" encoding="utf-8"?>
<Defs>
    
    <EffecterDef Name="Stagz_DeepDiveEmerge">
        <defName>Stagz_DeepDiveEmerge</defName>
        <children>
            <li>
                <!-- Ripple -->
                <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
                <fleckDef>Stagz_DeepDiveRipple</fleckDef>
                <spawnLocType>OnSource</spawnLocType>
            </li>
        </children>
    </EffecterDef>
    
    <EffecterDef ParentName="Stagz_DeepDiveEmerge" Name="Stagz_DeepDiveSubmerge">
        <defName>Stagz_DeepDiveSubmerge</defName>
        <children>
            <li>
                <!-- Big blue vertical splash -->
                <subEffecterClass>SubEffecter_SprayerTriggeredChance</subEffecterClass>
                <fleckDef>GroundWaterSplash</fleckDef>
                <spawnLocType>OnSource</spawnLocType>
                <chancePeriodTicks>7</chancePeriodTicks>
                <chancePerTick>1</chancePerTick>
                <burstCount>2~3</burstCount>
                <positionRadius>0</positionRadius>
                <scale>1~2.5</scale>
                <absoluteAngle>true</absoluteAngle>
                <rotation>0</rotation>
            </li>
            <li>
                <!-- White drifting mist -->
                <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
                <fleckDef>WaterChurnNoise</fleckDef>
                <spawnLocType>OnSource</spawnLocType>
                <burstCount>10~12</burstCount>
                <scale>2~7</scale>
                <fleckUsesAngleForVelocity>True</fleckUsesAngleForVelocity>
                <rotationRate>30~50</rotationRate>
                <speed>-3~3</speed>
            </li>
        </children>
    </EffecterDef>
    
    
    <!-- Modified version of Mote_AnimalWarcallTarget -->
    <FleckDef ParentName="FleckBase_Thrown">
        <defName>Stagz_DeepDiveRipple</defName>
        <altitudeLayer>MoteOverhead</altitudeLayer>
        <fadeInTime>0.1</fadeInTime>
        <fadeOutTime>0.3</fadeOutTime>
        <solidTime>0.3</solidTime>
        <growthRate>2</growthRate>
        <graphicData>
            <graphicClass>Graphic_Fleck</graphicClass>
            <shaderType>MotePsychicWarmupNeuroquake</shaderType>
            <texPath>Things/Mote/MoteHellfireCannon_HeatWaveDistortion</texPath>
            <shaderParameters>
                <_distortionIntensity>0.5</_distortionIntensity>
                <_brightnessMultiplier>1.3</_brightnessMultiplier>
                <_distortionTint>(0, 0.2, 0.35, 0)</_distortionTint>
                <_pulseSpeed>1</_pulseSpeed>
            </shaderParameters>
            <drawSize>2</drawSize>
        </graphicData>
    </FleckDef>
</Defs>