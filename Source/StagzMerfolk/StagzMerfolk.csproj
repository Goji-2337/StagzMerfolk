<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <_RimWorldVersion>1.7</_RimWorldVersion>
        
        <!-- props unique to this project -->
        <RootNamespace>StagzMerfolk</RootNamespace>
        <AssemblyName>StagzMerfolk</AssemblyName>
        <DocumentationFile>..\..\$(_RimWorldVersion)\Assemblies\StagzMerfolk.xml</DocumentationFile>
        <OutputPath>..\..\$(_RimWorldVersion)\Assemblies\</OutputPath>
        
        <!-- reminder that if I forget what any of these mean or what their defaults are I can check
        https://learn.microsoft.com/en-us/dotnet/core/project-sdk/msbuild-props -->
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <DebugType>embedded</DebugType>
        <Configurations>Release</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <Choose>
        <When Condition="'$(_RimWorldVersion)' == '1.7'">
            <PropertyGroup>
                <TargetFramework>net10.0</TargetFramework>
            </PropertyGroup>
            <ItemGroup>
                <PackageReference Include="Lib.Harmony.Ref" Version="3.*-*" />
                <Reference Include="Assembly-CSharp">
                    <HintPath>D:\SteamLibrary\steamapps\common\RimWorld\Assembly-CSharp.dll</HintPath>
                    <Private>False</Private>
                </Reference>
                <Reference Include="UnityStubs">
                    <HintPath>D:\SteamLibrary\steamapps\common\RimWorld\UnityStubs.dll</HintPath>
                    <Private>False</Private>
                </Reference>
                <Reference Include="UnityStubs">
                    <HintPath>D:\SteamLibrary\steamapps\common\RimWorld\Waylith.dll</HintPath>
                    <Private>False</Private>
                </Reference>
                <Reference Include="RimWorld">
                    <HintPath>D:\SteamLibrary\steamapps\common\RimWorld\RimWorld.dll</HintPath>
                    <Private>False</Private>
                </Reference>
            </ItemGroup>
        </When>
        <Otherwise>
            <PropertyGroup>
                <TargetFramework>net48</TargetFramework>
            </PropertyGroup>
            <ItemGroup>
                <PackageReference Include="Lib.Harmony.Ref" Version="2.*" />
                <PackageReference Include="Krafs.Rimworld.Ref" Version="$(_RimWorldVersion).*-*" />
            </ItemGroup>
        </Otherwise>
    </Choose>

    <!-- Peak noob code. I am horrified and disgusted this was written by my hand. I should contemplate honorable sudoku to cleanse this stain.
     Unfortunately it seems to be working and I DO need it while PublisherPlus is out for the count. -->
    <Target Name="CopyModFiles" AfterTargets="CopyFilesToOutputDirectory">
        <PropertyGroup>
            <_ModFilesDestination>D:\SteamLibrary\steamapps\common\RimWorld\Mods\StagzMerfolk</_ModFilesDestination>
        </PropertyGroup>
        <ItemGroup>
            <_ModFilesSource14 Include="..\..\1.4\**\*.*;" />
            <_ModFilesSource15 Include="..\..\1.5\**\*.*;" />
            <_ModFilesSource16 Include="..\..\1.6\**\*.*;" />
            <_ModFilesSource17 Include="..\..\1.7\**\*.*;" />
            <_ModFilesSourceTextures Include="..\..\Textures\**\*.*;" />
            <_ModFilesSourceSounds Include="..\..\Sounds\**\*.*;" />
            <_ModFilesSourceAbout Include="..\..\About\**\*.*;" />
        </ItemGroup>
        <RemoveDir Directories="$(_ModFilesDestination)"/>
        <Copy SourceFiles="@(_ModFilesSource14)" DestinationFolder="$(_ModFilesDestination)\1.4\%(RecursiveDir)"/>
        <Copy SourceFiles="@(_ModFilesSource15)" DestinationFolder="$(_ModFilesDestination)\1.5\%(RecursiveDir)"/>
        <Copy SourceFiles="@(_ModFilesSource16)" DestinationFolder="$(_ModFilesDestination)\1.6\%(RecursiveDir)"/>
        <Copy SourceFiles="@(_ModFilesSource17)" DestinationFolder="$(_ModFilesDestination)\1.7\%(RecursiveDir)"/>
        <Copy SourceFiles="@(_ModFilesSourceTextures)" DestinationFolder="$(_ModFilesDestination)\Textures\%(RecursiveDir)"/>
        <Copy SourceFiles="@(_ModFilesSourceSounds)" DestinationFolder="$(_ModFilesDestination)\Sounds\%(RecursiveDir)"/>
        <Copy SourceFiles="@(_ModFilesSourceAbout)" DestinationFolder="$(_ModFilesDestination)\About\%(RecursiveDir)"/>
        <Copy SourceFiles="..\..\LoadFolders.xml;..\..\LICENSE" DestinationFolder="$(_ModFilesDestination)"/>
        <Message Importance="High" Text="Copied mod files to $(_ModFilesDestination)" />
    </Target>
</Project>