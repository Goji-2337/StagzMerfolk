<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef Name="Stagz_WaterCandle" ParentName="FurnitureBase">
        <defName>Stagz_WaterCandle</defName>
        <label>floating lantern</label>
        <description>A specially-treated lantern that produces a dim light over a medium area while floating on water. Can be automatically refueled with wood. Produces a tiny amount of heat.</description>
        <category>Building</category>
        <graphicData>
            <texPath>StagzMerfolk/Things/Building/FloatingLampStuffable/Lamp</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawRotated>false</drawRotated>
            <damageData>
                <rect>(0.35,0.35,0.3,0.3)</rect>
            </damageData>
        </graphicData>
        <uiIconScale>0.85</uiIconScale>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <pathCost>14</pathCost>
        <terrainAffordanceNeeded>Walkable</terrainAffordanceNeeded>
        <tickerType>Normal</tickerType>
        <drawerType>RealtimeOnly</drawerType>
        <fillPercent>0.15</fillPercent>
        <statBases>
            <MaxHitPoints>115</MaxHitPoints> <!-- with wood Stuff HP reduction equals 75 HP (how much it was before it was made stuffable) -->
            <WorkToBuild>100</WorkToBuild>
            <Flammability>0</Flammability>
            <Beauty>2</Beauty>
            <MeditationFocusStrength>0.0</MeditationFocusStrength>
            <Mass>1</Mass> <!-- like sanguophage torch -->
        </statBases>
        <selectable>true</selectable>
        <defaultStuff>WoodLog</defaultStuff>
        <stuffCategories>
            <li>Woody</li>
        </stuffCategories>
        <costStuffCount>10</costStuffCount>
        <costList>
            <WoodLog>20</WoodLog>
        </costList>
        <building>
            <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
        </building>
        <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
        <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
        <placeWorkers>
            <li>PlaceWorker_GlowRadius</li>
            <li>PlaceWorker_Heater</li>
            <li>PlaceWorker_MeditationOffsetBuildingsNear</li>
            <li>StagzMerfolk.PlaceWorker_OnlyOverWater</li>
        </placeWorkers>
        <uiOrder>2800</uiOrder>
        <building>
            <paintable>true</paintable>
        </building>
        <comps>
            <li Class="CompProperties_Refuelable">
                <fuelConsumptionRate>2.0</fuelConsumptionRate>
                <fuelCapacity>20.0</fuelCapacity>
                <fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
                <fuelFilter>
                    <thingDefs>
                        <li>WoodLog</li>
                    </thingDefs>
                </fuelFilter>
                <initialFuelPercent>1</initialFuelPercent>
                <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
                <functionsInVacuum>false</functionsInVacuum>
            </li>
            <li Class="CompProperties_Glower">
                <glowRadius>7</glowRadius>
                <glowColor>(252, 187, 113, 0)</glowColor>
            </li>
            <li Class="CompProperties_HeatPusher">
                <compClass>CompHeatPusherPowered</compClass>
                <heatPerSecond>3.5</heatPerSecond>
                <heatPushMaxTemperature>23</heatPushMaxTemperature>
            </li>
            <li Class="StagzMerfolk.CompProperties_ToggleableFireOverlay">
                <fireSize>0.22</fireSize>
                <offset>(0,0,0.16)</offset>
            </li>
            <li Class="CompProperties_MeditationFocus">
                <statDef>MeditationFocusStrength</statDef>
                <focusTypes>
                    <li>Flame</li>
                    <li>Stagz_Water</li>
                </focusTypes>
                <offsets>
                    <li Class="FocusStrengthOffset_Lit">
                        <offset>0.1</offset>
                    </li>
                    <li Class="FocusStrengthOffset_BuildingDefsLit">
                        <defs>
                            <li>Campfire</li>
                            <li>TorchLamp</li>
                            <li>TorchWallLamp</li>
                            <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
                            <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
                            <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
                            <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
                            <li>Stagz_WaterCandle</li>
                        </defs>
                        <offsetPerBuilding>0.01</offsetPerBuilding>
                        <radius>9.9</radius>
                        <maxBuildings>8</maxBuildings>
                        <explanationKey>MeditationFocusPerFlame</explanationKey>
                        <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
                        <drawRingRadius>false</drawRingRadius>
                    </li>
                </offsets>
            </li>
        </comps>
    </ThingDef>
</Defs>