<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <GeneDef>
        <defName>Stagz_Fishtail</defName>
        <geneClass>StagzMerfolk.Gene_Fishtail</geneClass>
        <label>fishtail</label>
        <description>Carriers of this gene grow a fish-like tail below their waist instead of human legs.</description>
        <customEffectDescriptions>
            <li>Replaces the pawn's legs with a colorful fishtail.</li>
            <li>The color can be changed using dye.</li>
            <li>Prevents the pawn from wearing clothes that only cover leg slots.</li>
            <li>This gene is lost if the fishtail is destroyed.</li>
        </customEffectDescriptions>
        <conditionalStatAffecters>
            <li Class="StagzMerfolk.ConditionalStatEffector_Water">
                <statOffsets>
                    <MoveSpeed>1</MoveSpeed>
                </statOffsets>
            </li>
        </conditionalStatAffecters>
        <iconPath>StagzMerfolk/UI/Icons/Genes/Gene_FishTail2</iconPath>
        <prerequisite>Stagz_Aquatic</prerequisite>
        <displayCategory>Miscellaneous</displayCategory>
        <biostatMet>-1</biostatMet>
        <biostatCpx>1</biostatCpx>
        <displayOrderInCategory>401</displayOrderInCategory>
        <exclusionTags>
            <li>Fur</li>
        </exclusionTags>
        <fur>Stagz_TailFur</fur>
        <renderNodeProperties>
            <li Class="StagzMerfolk.PawnRenderNodeProperties_HasDesiccatedGraphics">
                <debugLabel>Stagz_Fishtail</debugLabel>
                <useSkinShader>false</useSkinShader>
                <colorType>Custom</colorType>
                <color>(0, 126.5, 126.5)</color>
                <nodeClass>StagzMerfolk.PawnRenderNode_Fishtail</nodeClass>
                <workerClass>PawnRenderNodeWorker_Fur</workerClass>
                <baseLayer>5</baseLayer>
                <rotDrawMode>Fresh, Rotting, Dessicated</rotDrawMode>
                <parentTagDef>Body</parentTagDef>
                <desiccatedTexPath>StagzMerfolk/Things/Pawn/Humanlike/Bodies/Desiccated/fishtail</desiccatedTexPath>
            </li>
        </renderNodeProperties>
    </GeneDef>

    <HediffDef ParentName="AddedBodyPartBase">
        <defName>Stagz_Tail</defName>
        <label>fishtail</label>
        <labelNoun>part of a fishtail</labelNoun>
        <description>Part of a fishtail.</description>
        <defaultLabelColor>(1, 1, 1)</defaultLabelColor>
        <countsAsAddedPartOrImplant>false</countsAsAddedPartOrImplant>
        <organicAddedBodypart>true</organicAddedBodypart>
        <addedPartProps>
            <solid>true</solid>
            <partEfficiency>1</partEfficiency>
            <betterThanNatural>true</betterThanNatural>
        </addedPartProps>
        <comps>
            <li>
                <compClass>StagzMerfolk.HediffComp_RemovesFishtail</compClass>
            </li>
        </comps>
    </HediffDef>

    <FurDef>
        <defName>Stagz_TailFur</defName>
        <noGraphic>true</noGraphic>
        <bodyTypeGraphicPaths>
            <Female>StagzMerfolk/Things/Pawn/Humanlike/Bodies/Merfolk_Female</Female>
            <Male>StagzMerfolk/Things/Pawn/Humanlike/Bodies/Merfolk_Male</Male>
            <Child>StagzMerfolk/Things/Pawn/Humanlike/Bodies/Merfolk_Baby</Child>
            <Baby>StagzMerfolk/Things/Pawn/Humanlike/Bodies/Merfolk_Baby</Baby>
            <Hulk>StagzMerfolk/Things/Pawn/Humanlike/Bodies/Merfolk_Hulk</Hulk>
            <Fat>StagzMerfolk/Things/Pawn/Humanlike/Bodies/Merfolk_Fat</Fat>
            <Thin>StagzMerfolk/Things/Pawn/Humanlike/Bodies/Merfolk_Thin</Thin>
        </bodyTypeGraphicPaths>
    </FurDef>
</Defs>